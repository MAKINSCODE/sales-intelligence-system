{
  "name": "sales-intel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d --wait",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server src/worker/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tavily/core": "^0.7.14",
    "bullmq": "^6.3.14",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.56.0",
    "next": "^16.4.5",
    "nodemailer": "^10.1.0",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
