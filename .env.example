# Copy to .env and fill in. Never commit .env.

# Public base URL used in magic-link emails
APP_URL=http://localhost:3000

# Session signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# Comma-separated emails that are created as admins on first start
BOOTSTRAP_ADMIN_EMAILS=

# PostgreSQL (matches docker-compose.yml; use a dedicated database elsewhere)
DATABASE_URL=postgresql://sales_intel:sales_intel_dev@localhost:5440/sales_intel

# Redis (no auth); keys are namespaced by REDIS_PREFIX
REDIS_URL=redis://localhost:6390
REDIS_PREFIX=jada-sales-intel:local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Tavily
TAVILY_API_KEY=

# Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
# If outbound 587 is blocked on a network, Brevo also accepts 2525 (STARTTLS) and 465 (implicit TLS).
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME=Sales Intelligence

# Apify: recent LinkedIn posts via harvestapi/linkedin-post-search. Leave APIFY_TOKEN empty to switch posts off.
APIFY_TOKEN=
APIFY_MAX_CHARGE_USD=0.25

# Research guardrails (per brief)
RESEARCH_MAX_SECONDS=420
RESEARCH_MAX_SEARCHES=14
RESEARCH_MAX_PAGES=20
RESEARCH_MAX_LLM_CALLS=14
RESEARCH_MAX_POSTS=12
RESEARCH_MAX_POST_RUNS=3
RESEARCH_CONCURRENCY=2

# Dev only: when true, magic links are printed to the server log and shown on the sign-in page
DEV_SHOW_MAGIC_LINK=false

# Web server address and port. Use BIND_HOST=172.17.0.1 when nginx runs in Docker; INTERNAL_APP_URL must then use the same address.
BIND_HOST=127.0.0.1
PORT=3000
INTERNAL_APP_URL=http://127.0.0.1:3000

# Logging: one structured record per line. LOG_FORMAT defaults to "pretty" in development and "json" in production.
# Follow a run across web and worker by searching for its reference (shown in the app next to errors), e.g. ref=1a2b3c4d.
LOG_LEVEL=info
LOG_FORMAT=
# PDF export: parallel renders allowed on this server (each is a full browser page)
PDF_MAX_CONCURRENT=2
